#!/usr/bin/env bash
# Resumo dos bloqueios do firewall (UFW).
# Uso: sudo bloqueios [período]     ex.: sudo bloqueios 24h | sudo bloqueios 7d | sudo bloqueios 1h
# Fonte: log do kernel "UFW BLOCK" (tem limite de taxa; em ataque forte mostra menos que o real).
set -uo pipefail

periodo="${1:-24h}"
case "$periodo" in
  *h) desde="-${periodo%h}h" ;;
  *d) desde="-${periodo%d}d" ;;
  *)  echo "Uso: bloqueios [Nh|Nd]   (ex.: 1h, 24h, 7d)"; exit 1 ;;
esac

dados=$(journalctl -k --since "$desde" --no-pager -o short-iso 2>/dev/null \
  | grep 'UFW BLOCK' | grep 'DPT=' \
  | sed -E 's/^([0-9-]+)T([0-9]{2}).*SRC=([^ ]+) .*PROTO=([^ ]+) .*DPT=([0-9]+).*/\1 \2 \3 \4 \5/')

if [ -z "$dados" ]; then
  echo "Nenhum bloqueio registrado em ${periodo}."
  exit 0
fi

total=$(printf '%s\n' "$dados" | wc -l)
ips=$(printf '%s\n' "$dados" | awk '{print $3}' | sort -u | wc -l)

echo "=== Bloqueios do firewall: últimas ${periodo} ==="
echo "Total: ${total} bloqueios, vindos de ${ips} IPs diferentes"
echo
echo "--- Por dia ---"
printf '%s\n' "$dados" | awk '{print $1}' | sort | uniq -c | awk '{printf "  %s  %6d\n", $2, $1}'
echo
echo "--- Portas mais atacadas (top 10) ---"
printf '%s\n' "$dados" | awk '{print $5"/"$4}' | sort | uniq -c | sort -rn | head -10 \
  | awk '{printf "  %-12s %6d\n", $2, $1}'
echo
echo "--- IPs que mais tentaram (top 10) ---"
printf '%s\n' "$dados" | awk '{print $3}' | sort | uniq -c | sort -rn | head -10 \
  | awk '{printf "  %-16s %6d\n", $2, $1}'
exit 0
